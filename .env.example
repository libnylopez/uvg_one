# UVG ONE — copia este archivo como .env y completa los valores.
#   cp .env.example .env
# El archivo .env NUNCA se sube a git (está en .gitignore).

# --- Claude (Anthropic) ---
# Pega aquí tu API key (https://console.anthropic.com/ → API Keys).
ANTHROPIC_API_KEY=
# Modelo de bajo costo para consultas documentales.
ANTHROPIC_MODEL=claude-haiku-5-5
# Profundidad de razonamiento: low | medium | high
ANTHROPIC_EFFORT=low
# real: usa Claude · simulado: respuestas locales marcadas como SIMULACIÓN (pruebas / demo sin conexión)
ANTHROPIC_MODE=real
# Tope de tokens de salida por llamada (incluye el razonamiento interno del modelo)
ANTHROPIC_MAX_TOKENS=4000
# Presupuesto de seguridad en USD: ninguna llamada se hace si lo gastado + la estimación lo supera.
# El consumo se registra en backend/data/usage/anthropic_usage.jsonl (ver GET /usage).
ANTHROPIC_BUDGET_USD=0.50
# Reintentos automáticos ante errores transitorios (nunca ilimitados)
ANTHROPIC_MAX_RETRIES=1

# Preguntas de seguimiento: local (sin costo, recomendado) | llm (una llamada extra por seguimiento)
REWRITE_MODE=local

# --- PostgreSQL (historial de conversaciones y registro de documentos) ---
POSTGRES_USER=uvg_one
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=uvg_one

# --- Sesiones de invitado ---
# Genera uno con: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=cambia-este-secreto

# --- Aplicación ---
LOG_LEVEL=INFO

# --- Pipeline RAG (valores por defecto recomendados; normalmente no hace falta tocarlos) ---
# Cambiar el modelo de embeddings o la fragmentación reindexa todo al arrancar.
RAG_EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
RAG_TOP_K=10
RAG_MIN_SIMILARITY_THRESHOLD=0.35
RAG_EVIDENCE_SIMILARITY_THRESHOLD=0.55
RAG_CONTEXT_CHAR_BUDGET=7000
